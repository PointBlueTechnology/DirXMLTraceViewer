<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pointbluetech</groupId>
    <artifactId>DirXMLTraceViewer</artifactId>
    <version>1.12.0</version>
    <packaging>pom</packaging>
    <name>DirXML Trace Viewer</name>
    <description>A viewer for NetIQ/OpenText Identity Manager (DirXML) DSTrace output, and the trace parser it is built on.</description>
    <url>https://github.com/PointBlueTechnology/DirXMLTraceViewer</url>

    <organization>
        <name>Point Blue Technology</name>
        <url>https://www.pointbluetech.com</url>
    </organization>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Point Blue Technology</name>
            <organization>Point Blue Technology</organization>
            <organizationUrl>https://www.pointbluetech.com</organizationUrl>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <url>https://github.com/PointBlueTechnology/DirXMLTraceViewer</url>
        <connection>scm:git:https://github.com/PointBlueTechnology/DirXMLTraceViewer.git</connection>
        <developerConnection>scm:git:git@github.com:PointBlueTechnology/DirXMLTraceViewer.git</developerConnection>
    </scm>

    <!-- Two modules:
           trace-core  the DSTrace parser, formatter, highlighter, filters, file reader and the LDAP
                       event-monitoring source. A library other programs use (DirXMLDevWeb's trace view).
                       Depends on jldap only.
           app         the Swing viewer: the window, dialogs, update check, launchers, the macOS app.
         Both carry this version; a release attaches the app jar, the zip, the DMG and the trace-core jar. -->
    <modules>
        <module>trace-core</module>
        <module>app</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jldap.version>4.3</jldap.version>
        <junit.version>5.11.3</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.novell.ldap</groupId>
                <artifactId>jldap</artifactId>
                <version>${jldap.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <!-- Maven Central: sources, javadoc, signatures, and the bundle Central takes. Only trace-core
                 is published (`mvn -Pcentral -pl trace-core deploy`); its pom is flattened, so the parent
                 is not needed. The bundle is built, not uploaded (skipUpload): DirXMLDev's
                 bin/publish-central checks it for names that must not be published, then uploads it. -->
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <skipUpload>true</skipUpload>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
